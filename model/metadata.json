{
  "dataset": "Breast Cancer Wisconsin (Diagnostic)",
  "source_url": "https://archive.ics.uci.edu/dataset/17/breast-cancer-wisconsin-diagnostic",
  "dataset_doi": "https://doi.org/10.24432/C5DW2B",
  "dataset_license": "CC BY 4.0",
  "loader": "sklearn.datasets.load_breast_cancer(as_frame=True)",
  "feature_names": [
    "mean_radius",
    "mean_texture",
    "mean_perimeter",
    "mean_area",
    "mean_smoothness",
    "mean_compactness",
    "mean_concavity",
    "mean_concave_points",
    "mean_symmetry",
    "mean_fractal_dimension",
    "radius_error",
    "texture_error",
    "perimeter_error",
    "area_error",
    "smoothness_error",
    "compactness_error",
    "concavity_error",
    "concave_points_error",
    "symmetry_error",
    "fractal_dimension_error",
    "worst_radius",
    "worst_texture",
    "worst_perimeter",
    "worst_area",
    "worst_smoothness",
    "worst_compactness",
    "worst_concavity",
    "worst_concave_points",
    "worst_symmetry",
    "worst_fractal_dimension"
  ],
  "target_column": "target",
  "target_mapping": {
    "0": "Benign",
    "1": "Malignant"
  },
  "original_sklearn_target_mapping": {
    "0": "Malignant",
    "1": "Benign"
  },
  "target_conversion": "project_target = 1 - sklearn_target",
  "random_state": 42,
  "test_size": 0.2,
  "n_samples": 569,
  "n_features": 30,
  "train_rows": 455,
  "test_rows": 114,
  "class_counts": {
    "0": 357,
    "1": 212
  },
  "train_class_counts": {
    "0": 285,
    "1": 170
  },
  "test_class_counts": {
    "0": 72,
    "1": 42
  },
  "sklearn_version": "1.8.0",
  "python_version": "3.12.10",
  "numpy_version": "2.3.5",
  "pandas_version": "2.2.3",
  "scipy_version": "1.17.0",
  "joblib_version": "1.5.3",
  "models": {
    "Logistic Regression": {
      "file": "logistic_regression.joblib",
      "classifier": "LogisticRegression",
      "parameters": {
        "C": 1.0,
        "class_weight": null,
        "dual": false,
        "fit_intercept": true,
        "intercept_scaling": 1,
        "l1_ratio": 0.0,
        "max_iter": 5000,
        "n_jobs": null,
        "penalty": "deprecated",
        "random_state": 42,
        "solver": "lbfgs",
        "tol": 0.0001,
        "verbose": 0,
        "warm_start": false
      },
      "preprocessing": [
        "training-median imputation",
        "training-fitted StandardScaler"
      ]
    },
    "Decision Tree": {
      "file": "decision_tree.joblib",
      "classifier": "DecisionTreeClassifier",
      "parameters": {
        "ccp_alpha": 0.0,
        "class_weight": null,
        "criterion": "gini",
        "max_depth": 5,
        "max_features": null,
        "max_leaf_nodes": null,
        "min_impurity_decrease": 0.0,
        "min_samples_leaf": 2,
        "min_samples_split": 2,
        "min_weight_fraction_leaf": 0.0,
        "monotonic_cst": null,
        "random_state": 42,
        "splitter": "best"
      },
      "preprocessing": [
        "training-median imputation"
      ]
    },
    "KNN": {
      "file": "knn.joblib",
      "classifier": "KNeighborsClassifier",
      "parameters": {
        "algorithm": "auto",
        "leaf_size": 30,
        "metric": "minkowski",
        "metric_params": null,
        "n_jobs": null,
        "n_neighbors": 5,
        "p": 2,
        "weights": "uniform"
      },
      "preprocessing": [
        "training-median imputation",
        "training-fitted StandardScaler"
      ]
    },
    "Naive Bayes": {
      "file": "naive_bayes.joblib",
      "classifier": "GaussianNB",
      "parameters": {
        "priors": null,
        "var_smoothing": 1e-09
      },
      "preprocessing": [
        "training-median imputation",
        "training-fitted StandardScaler"
      ]
    },
    "Support Vector Machine": {
      "file": "svm.joblib",
      "classifier": "SVC",
      "parameters": {
        "C": 1.0,
        "break_ties": false,
        "cache_size": 200,
        "class_weight": null,
        "coef0": 0.0,
        "decision_function_shape": "ovr",
        "degree": 3,
        "gamma": "scale",
        "kernel": "rbf",
        "max_iter": -1,
        "probability": true,
        "random_state": 42,
        "shrinking": true,
        "tol": 0.001,
        "verbose": false
      },
      "preprocessing": [
        "training-median imputation",
        "training-fitted StandardScaler"
      ]
    }
  }
}
